{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_NEWSAPI_KEY": "@EXPO_PUBLIC_NEWSAPI_KEY",
        "EXPO_PUBLIC_TMDB_KEY": "@EXPO_PUBLIC_TMDB_KEY"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_NEWSAPI_KEY": "@EXPO_PUBLIC_NEWSAPI_KEY",
        "EXPO_PUBLIC_TMDB_KEY": "@EXPO_PUBLIC_TMDB_KEY"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_NEWSAPI_KEY": "@EXPO_PUBLIC_NEWSAPI_KEY",
        "EXPO_PUBLIC_TMDB_KEY": "@EXPO_PUBLIC_TMDB_KEY"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
